# Database Configuration
POSTGRES_USER=artup
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=artup
DATABASE_URL=postgresql://artup:your_secure_password_here@postgres:5432/artup

# Domain Configuration
# For production: your actual domain (e.g., blog.example.com)
# For local dev: localhost:3000
DOMAIN=blog.example.com
NEXTAUTH_URL=https://blog.example.com

# Auth.js Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Email Configuration (for magic link authentication)
# Examples:
# - SMTP: smtp://username:password@smtp.example.com:587
# - Gmail: smtp://username:password@smtp.gmail.com:587
# - Resend: smtp://resend:YOUR_API_KEY@smtp.resend.com:465
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=noreply@example.com

# Admin Configuration
ADMIN_EMAIL=admin@example.com

# Development-only (for docker-compose.dev.yml)
# Uncomment for local development:
# DATABASE_URL=postgresql://artup:artup_dev_password@localhost:5432/artup
# NEXTAUTH_URL=http://localhost:3000
