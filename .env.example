# Database Configuration
# SQLite database file path (local or production)
DATABASE_URL=file:./prisma/dev.db

# Site URL Configuration
# Used for Open Graph meta tags and canonical URLs
# For production: https://yourdomain.com
# For local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth.js URL Configuration
# For production: https://yourdomain.com
# For local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Auth.js Secret
# Generate with: openssl rand -base64 32
# Or use any random string generator
NEXTAUTH_SECRET=your_nextauth_secret_here

# Admin Account Setup
# Used by "npm run setup" to create initial admin user
# Change these before running setup for the first time
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
