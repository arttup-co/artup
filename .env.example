# Database Configuration
# SQLite database file (in Docker: /data/artup.db, local dev: ./prisma/dev.db)
DATABASE_URL=file:./prisma/dev.db

# Domain Configuration
# For production: your actual domain (e.g., blog.example.com)
# For local dev: localhost:3000
DOMAIN=blog.example.com
NEXTAUTH_URL=https://blog.example.com

# Auth.js Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Admin Configuration
# Used during installation to create the initial admin account
# In production, these are set by install.sh and used once
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Development-only defaults
# For local development with default credentials:
# - Username: admin
# - Password: admin
# To use these, uncomment the lines below:
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin
# NEXTAUTH_URL=http://localhost:3000
